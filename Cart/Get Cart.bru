meta {
  name: Get Cart
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/carts/{{cartId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has cart data", function() {
    expect(res.body).to.be.an('object');
  });
}
