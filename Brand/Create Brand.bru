meta {
  name: Create Brand
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/brands
  body: json
  auth: none
}

body:json {
  {
    "name": "New Brand",
    "slug": "new-brand"
  }
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response has id", function() {
    expect(res.body.id).to.be.a('string');
  });
}
