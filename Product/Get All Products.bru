meta {
  name: Get All Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 10
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has data", function() {
    expect(res.body.data).to.be.an('array');
  });
}
