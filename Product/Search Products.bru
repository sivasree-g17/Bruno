meta {
  name: Search Products
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/products/search?q=hammer
  body: none
  auth: none
}

params:query {
  q: hammer
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has search results", function() {
    expect(res.body).to.exist;
    const items = Array.isArray(res.body)
      ? res.body
      : (res.body.data || res.body.products || Object.values(res.body).find(Array.isArray) || []);
    expect(items).to.be.an('array');
  });
}
