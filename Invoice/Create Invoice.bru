meta {
  name: Create Invoice
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/invoices
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "billing_street": "123 Main St",
    "billing_city": "New York",
    "billing_state": "NY",
    "billing_country": "USA",
    "billing_postal_code": "10001",
    "payment_method": "cash-on-delivery",
    "payment_details": {},
    "cart_id": "01HQZM9VKD8YJXBVZ8QJKQJ0YN"
  }
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Invoice created", function() {
    expect(res.body.invoice_number).to.exist;
  });
}
